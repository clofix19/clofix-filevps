# Local development only. Replace these before exposing any service beyond localhost.
DB_PASSWORD=change-this-postgres-password
CLOFIX_ADMIN_EMAIL=admin@example.com
CLOFIX_ADMIN_PASSWORD=change-this-admin-password-12
S3_ACCESS_KEY=clofixdevaccesskey
S3_SECRET_KEY=clofixdevsecretkey-change-me
# Local workers use Docker's private service DNS; keep this on loopback for macOS.
S3_MASTER_BIND_IP=127.0.0.1

# Local CKS lab executor (Compose worker has no kubeadm). Set 0 to disable.
# Production workers: never set CLOFIX_KUBERNETES_FAKE=1. Use scripts/install-cks-worker.sh
# then set CLOFIX_K8S_E2E=1 on the controller after HA/etcd verification.
CLOFIX_KUBERNETES_FAKE=1
# CLOFIX_K8S_E2E=1
# Docker product lab socket (Docker Desktop macOS). Linux: /var/run/docker.sock
# CLOFIX_DOCKER_PRODUCT_SOCK=/Users/you/.docker/run/docker.sock
# CLOFIX_DOCKER_PRODUCT_HOST=unix:///var/run/docker.sock

# ACME / public HTTPS for ALB + managed-app domains (HTTP-01 on :80, TLS on :443).
# CLOFIX_ACME_EMAIL=ops@example.com
# CLOFIX_HTTPS_LISTEN=:443

# SeaweedFS replication: 000 lab single-copy; 001 for two copies when ≥2 volume servers.
# S3_DEFAULT_REPLICATION=001

# Optional SMTP for mailto: health alert channels.
# CLOFIX_SMTP_HOST=smtp.example.com:587
# CLOFIX_SMTP_USER=
# CLOFIX_SMTP_PASSWORD=
# CLOFIX_SMTP_FROM=alerts@example.com

# Customer controller connects to the CloFix company license service.
# Set the actual company HTTPS URLs here or under Settings > License.
CLOFIX_LICENSE_SERVER_URL=
CLOFIX_LICENSE_PUBLIC_URL=
