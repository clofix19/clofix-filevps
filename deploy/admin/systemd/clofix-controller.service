[Unit]
Description=CloFix FileVPS Admin Controller
Documentation=https://clofix.com
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=clofix
Group=clofix
EnvironmentFile=-/etc/clofix/controller.env
WorkingDirectory=/opt/clofix-admin
ExecStart=/usr/local/bin/clofix-controller
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
