# Admin controller - remote deploy (native or Docker).

# Remote SSH (app host)
CLOFIX_REMOTE_IP=
CLOFIX_REMOTE_USER=root
CLOFIX_REMOTE_PASSWORD=
# CLOFIX_REMOTE_SSH_KEY=~/.ssh/id_rsa
CLOFIX_REMOTE_PORT=22
CLOFIX_REMOTE_DIR=/opt/clofix-admin

# Optional: Postgres on a different host (install-db / deploy-db-runtime)
# DB_REMOTE_IP=
# DB_REMOTE_USER=root
# DB_REMOTE_PASSWORD=
# DB_REMOTE_PORT=22

# Admin bootstrap
CLOFIX_ADMIN_EMAIL=admin@example.com
CLOFIX_ADMIN_PASSWORD=change-this-admin-password-12

# Postgres (database runtime)
DB_NAME=clofix
DB_USER=clofix
DB_PASSWORD=change-this-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable

# License server (reachable from this admin host)
CLOFIX_LICENSE_SERVER_URL=http://LICENSE_HOST:8090
CLOFIX_LICENSE_PUBLIC_URL=http://LICENSE_HOST:8090

# Native listen binds
CLOFIX_ADMIN_LISTEN=:8080
CLOFIX_WORKER_LISTEN=:8443
CLOFIX_DNS_LISTEN=127.0.0.1:53
CLOFIX_HTTP_LISTEN=127.0.0.1:80
CLOFIX_HTTPS_LISTEN=127.0.0.1:443
CLOFIX_TLS_NAMES=localhost,127.0.0.1

# Native deploy-native.sh runtimes (1=on)
WITH_DB_RUNTIME=1
WITH_S3_POOL=1

# S3 pool (SeaweedFS) - deploy-s3pool.sh / deploy-native.sh
S3_ACCESS_KEY=clofix-s3-access-key
S3_SECRET_KEY=clofix-s3-secret-key-change-me
S3_DEFAULT_REPLICATION=000
S3_WITH_LOCAL_VOLUME=1
S3_DATA_DIR=/var/lib/clofix-s3pool
S3_MASTER_BIND_IP=0.0.0.0
S3_GATEWAY_BIND=127.0.0.1
SEAWEEDFS_VERSION=4.51
# Address workers use (auto-set to REMOTE_IP:9333 when empty + WITH_S3_POOL=1)
CLOFIX_S3_MASTER_ADDRESS=

# Docker-only (./deploy.sh) extras
ADMIN_HTTP_BIND=0.0.0.0
ADMIN_MTLS_BIND=0.0.0.0
DNS_BIND=127.0.0.1
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1

GOOS=linux
GOARCH=amd64
