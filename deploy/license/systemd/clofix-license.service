[Unit]
Description=CloFix License Server
Documentation=https://clofix.com
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=clofix
Group=clofix
EnvironmentFile=-/etc/clofix/license.env
WorkingDirectory=/opt/clofix-license
ExecStart=/usr/local/bin/clofix-license
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
