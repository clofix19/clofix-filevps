# License server - remote deploy (native or Docker).

# Remote SSH (app host)
CLOFIX_REMOTE_IP=
CLOFIX_REMOTE_USER=root
CLOFIX_REMOTE_PASSWORD=
# CLOFIX_REMOTE_SSH_KEY=~/.ssh/id_rsa
CLOFIX_REMOTE_PORT=22
CLOFIX_REMOTE_DIR=/opt/clofix-license

# Optional: Postgres on a different host
# DB_REMOTE_IP=
# DB_REMOTE_USER=root
# DB_REMOTE_PASSWORD=
# DB_REMOTE_PORT=22

# License admin UI
LICENSE_ADMIN_USER=admin
LICENSE_ADMIN_PASSWORD=change-this-admin-password-12
LICENSE_BIND_IP=0.0.0.0
LICENSE_PORT=8090
CLOFIX_LICENSE_LISTEN=:8090

# Postgres (native)
LICENSE_DB_NAME=clofix_license
LICENSE_DB_USER=clofix
LICENSE_DB_PASSWORD=change-this-license-db-password
LICENSE_DB_HOST=127.0.0.1
LICENSE_DB_PORT=5432
LICENSE_DB_SSLMODE=disable

# Docker-only volumes (./deploy.sh)
LICENSE_DATA_VOLUME=clofix-license-server-data
LICENSE_DB_VOLUME=clofix-license-server-db

GOOS=linux
GOARCH=amd64
