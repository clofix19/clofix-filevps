# Step 1 — License server (company-side). Deploy first.

# Remote SSH
CLOFIX_REMOTE_IP=
CLOFIX_REMOTE_USER=root
CLOFIX_REMOTE_PASSWORD=
# CLOFIX_REMOTE_SSH_KEY=~/.ssh/id_rsa
CLOFIX_REMOTE_PORT=22
CLOFIX_REMOTE_DIR=/opt/clofix-license

# License service (copied to remote as .env for docker compose)
LICENSE_ADMIN_USER=admin
LICENSE_ADMIN_PASSWORD=change-this-admin-password-12
LICENSE_BIND_IP=0.0.0.0
LICENSE_PORT=8090
LICENSE_DATA_VOLUME=clofix-license-server-data
LICENSE_DB_PASSWORD=change-this-license-db-password
LICENSE_DB_VOLUME=clofix-license-server-db
