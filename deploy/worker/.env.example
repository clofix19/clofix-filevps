# Step 3 — Linux worker (native .deb + enroll). Deploy after admin.

CLOFIX_REMOTE_IP=
CLOFIX_REMOTE_USER=root
CLOFIX_REMOTE_PASSWORD=
# CLOFIX_REMOTE_SSH_KEY=~/.ssh/id_rsa
CLOFIX_REMOTE_PORT=22
CLOFIX_REMOTE_DIR=/opt/clofix-worker

# Admin from step 2 (reachable from this worker)
CLOFIX_CONTROLLER=https://ADMIN_HOST:8443
CLOFIX_ADMIN_HTTP=http://ADMIN_HOST:8080
# Required: ctl-… from Admin → Settings → License (or leave blank to fetch via CLOFIX_ADMIN_HTTP)
CLOFIX_INSTALLATION_ID=
# Optional reference: CFL-… key issued for that Installation ID (paste in Admin → Settings → License)
CLOFIX_LICENSE_KEY=
CLOFIX_TOKEN=

# S3 master from step 2 (reachable IP — not s3pool:9333)
CLOFIX_S3_MASTER_ADDRESS=ADMIN_HOST:9333
CLOFIX_S3_ADVERTISE_ADDRESS=
WITH_S3_POOL=1
WITH_S3_FIREWALL=1

VERSION=0.1.0
GOARCH=amd64
SEAWEEDFS_VERSION=4.51

WITH_HOST_DEPS=1
WITH_DOCKER=1
WITH_CKS=1
WITH_MANAGED_TEMPLATES=1
SKIP_ENROLL=0
